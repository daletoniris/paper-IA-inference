# =============================================================================
# .env.example - Configuracion del Agente Seguro
# =============================================================================
# INSTRUCCIONES:
#   1. Copia este archivo:  cp .env.example .env
#   2. Edita .env con tu configuracion
#   3. Nunca commitees el .env real (ya esta en .gitignore)
# =============================================================================

# --- Backend activo ---
# Opciones: "openrouter" o "ollama"
# Tambien se puede cambiar en caliente con el comando /backend
BACKEND=openrouter

# =============================================================================
# OPCION A: OpenRouter (recomendado para empezar)
# =============================================================================
# 1. Crea cuenta gratis en https://openrouter.ai
# 2. Genera una API key en https://openrouter.ai/keys
# 3. Pega tu key abajo (empieza con sk-or-v1-)

OPENROUTER_API_KEY=sk-or-v1-TU_API_KEY_AQUI

# Modelo recomendado para tool calling (barato y bueno):
OPENROUTER_MODEL=google/gemini-2.5-flash

# Otros modelos probados:
#   qwen/qwen3-32b                    -> $0.08/M tok, muy bueno
#   qwen/qwen3-coder-30b-a3b-instruct -> $0.15/M tok, mejor para codigo
#   anthropic/claude-sonnet-4          -> $3/M tok, top tier (caro)
#   mistralai/devstral-small:free      -> GRATIS, decente

# =============================================================================
# OPCION B: Ollama (local, gratis, offline)
# =============================================================================
# 1. Instala Ollama: curl -fsSL https://ollama.com/install.sh | sh
# 2. Descarga modelo: ollama pull qwen3:4b
# 3. Cambia BACKEND=ollama arriba

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Modelos Ollama recomendados:
#   qwen3:4b   -> 2.5 GB, mejor calidad (RECOMENDADO)
#   qwen3:1.7b -> 1.4 GB, rapido pero menos preciso
#   qwen3:8b   -> 5 GB, excelente pero mas lento

# =============================================================================
# AJUSTES
# =============================================================================

# Tokens maximos por respuesta del modelo
MAX_TOKENS=4096
